# --- 核心模型接入 (Core LLM) ---
# 建议统一使用 TA_ 前缀，同时也兼容 OPENAI_API_KEY / OPENAI_BASE_URL
TA_API_KEY=
TA_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
TA_LLM_PROVIDER=openai

# 模型名配置 (默认已提供常用值)
TA_LLM_QUICK=astron-code-latest
TA_LLM_DEEP=astron-code-latest
# 设为 1 时，所有用户保存的 provider/base/model 不再覆盖上面的全局远程 LLM；用户 Key 仍可从设置页读取。
# TA_FORCE_LLM_RUNTIME=1

# 本地开发自动登录账号；留空时使用内置测试账号。
# TA_DEV_USER_EMAIL=your@example.com

# --- 数据库 (PostgreSQL, 必填) ---
# 示例: postgresql://postgres:postgres@127.0.0.1:5432/tradingagents
DATABASE_URL=
# 不设置时复用 DATABASE_URL；如需单独库/Schema，可独立配置。
# STRATEGY_DATABASE_URL=

# --- 安全密钥 (Security) ---
# 用于加密用户 API Key 和签发 JWT，生产环境必须设置！
# 生成方式: openssl rand -base64 32
# 首次设置时，系统会自动将已有数据从默认密钥迁移到新密钥。
# TA_APP_SECRET_KEY=

# --- 进阶可选配置 (Advanced Optional) ---
# 提示词语言 (auto / zh / en)，默认 zh
# TA_LANGUAGE=zh

# 运行日志追踪 (1 开启 / 0 关闭)，默认 1
# TA_TRACE=1

# --- 后台任务 Worker ---
# QMT 账户资产/持仓/委托/成交后台同步。开启后不需要前端页面打开，也会按设置页同步配置刷新快照。
# ENABLE_QMT_SYNC_WORKER=1

# 回测数据自动增量更新。设置页“数据订阅”只保存订阅规则；
# 若这里不启用，后端不会按计划自动创建日K/分钟线补数任务。
# ENABLE_BACKTEST_AUTO_UPDATE_WORKER=1

# QMT 行情盘中采集与盘后同步。需要 QMT/桥接链路可用时再开启。
# ENABLE_QMT_MARKET_SYNC_WORKER=1

# QMT 订阅股票池 1 分钟线盘中采集。默认跟随 ENABLE_QMT_MARKET_SYNC_WORKER；
# 显式设为 0 可只跑行情同步，不跑订阅池分钟采集。
# ENABLE_QMT_MINUTE_SUBSCRIPTION_WORKER=1

# 分钟线采集成功后自动刷新实时 24h 主线机会榜，让盘中反应进入动态排序。
# AI_QUANT_MINUTE_CAPTURE_REFRESH_SELECTION=1
# AI_QUANT_MINUTE_SELECTION_REFRESH_INTERVAL_SECONDS=55
# 实时榜事件反应盘中主动补采分钟线；默认 auto 会在当日收盘后短超时补采。
# AI_QUANT_EVENT_MINUTE_CAPTURE_AFTER_HOURS=auto
# AI_QUANT_EVENT_MINUTE_CAPTURE_TIMEOUT_SECONDS=4
# 实时补采无数据时，向 QMT 历史分钟线 bridge 发起定向回填任务；页面只短等待任务创建。
# AI_QUANT_EVENT_MINUTE_HISTORY_BACKFILL=1
# AI_QUANT_EVENT_MINUTE_HISTORY_BACKFILL_TIMEOUT_SECONDS=2.5
# QMT 回填不可用时，只对当前候选标的做小批量 AKShare 分钟线补缺，成功后刷新进入事件反应。
# AI_QUANT_EVENT_MINUTE_AKSHARE_BACKFILL=1
# AI_QUANT_EVENT_MINUTE_AKSHARE_BACKFILL_SYMBOLS=5
# AI_QUANT_EVENT_MINUTE_AKSHARE_BACKFILL_COOLDOWN_SECONDS=600

# 1 分钟 K 线收盘后自动补齐缺口（通达信 pytdx 兜底）。
# 适合 QMT 桥接/订阅不稳定时启用。盘后 15:30~23:00 和盘前 06:00~09:00 各跑一次。
# ENABLE_MINUTE_KLINE_GAP_FILLER_WORKER=1
# MINUTE_GAP_FILLER_WORKERS=8   # pytdx 拉取并行进程数，默认 8

# 辩论与风险讨论轮数 (1-5)，默认 1
# TA_MAX_DEBATE=1
# TA_MAX_RISK=1

# --- VLM 截图识别 (Vision Language Model) ---
# 用于持仓截图识别，默认使用智谱 glm-4.6v-flash（免费）
# TA_VLM_API_KEY=你的智谱API Key
# TA_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TA_VLM_MODEL=glm-4.6v-flash

# --- 邮件服务 (Email/SMTP) ---
# 仅在需要开启邮箱验证码登录时配置
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=你的邮箱
# MAIL_PASS=你的授权码
# MAIL_FROM=发件人名称
# MAIL_SSL=1

# --- QMT 虚拟仓 (XtQuant / 极简模式) ---
# 启用后可在“虚拟仓”页面读取 QMT 模拟账户资产与持仓
# 注意：xtquant 交易接口通常需要运行在装有 QMT/miniQMT 的环境中，
# 并提供 userdata_mini 路径；仅有 192.168.10.1:58610 行情端口通常不足以直接读取交易资产。
# QMT_ENABLED=1
# QMT_HOST=192.168.10.1
# QMT_PORT=58610
# QMT_ACCOUNT_TYPE=STOCK
# QMT_REFRESH_INTERVAL_SECONDS=10
# QMT 账号、userdata_path、bridge_base_url 请在应用“设置”页保存到数据库。
# .env 只保留通用连接默认值与 bridge 鉴权 token，避免环境变量账号覆盖设置页。
# QMT_BRIDGE_TOKEN=your-bridge-token
# 回测/补数用的历史分钟线专用通道，默认建议使用只读实盘桥获取完整行情
# QMT_MINUTE_HISTORY_ACCOUNT_KEY=live_real
# QMT_MINUTE_HISTORY_BRIDGE_BASE_URL=http://192.168.10.1:8711
# QMT_MINUTE_HISTORY_BRIDGE_TOKEN=your-bridge-token
# 兼容旧配置：以下历史桥变量仍可保留给其他用途
# QMT_HISTORY_ACCOUNT_KEY=paper_sim
# QMT_HISTORY_BRIDGE_BASE_URL=http://192.168.10.1:8710
# QMT_HISTORY_BRIDGE_TOKEN=your-bridge-token
# QMT_MINUTE_DATABASE_URL=postgresql://user:password@192.168.10.x:5432/trading_agents

# 兼容说明: 系统自动识别 TA_ 前缀变量。
# 若需修改默认行为，取消上述注释并填值即可。
